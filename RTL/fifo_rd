module fifo_rd #(
  parameter P_SIZE = 8
)
(
   input  wire                   r_clk,
   input  wire                   r_rstn,
   input  wire                   r_inc,
   input  wire [P_SIZE-1:0]     sync_wr_ptr,
   output wire [P_SIZE-2:0]     rd_addr,
   output wire                   empty,
   output reg  [P_SIZE-1:0]     gray_rd_ptr
);

reg [P_SIZE-1:0] rd_ptr;

wire [P_SIZE-1:0] comb_gray_rd_ptr;

assign comb_gray_rd_ptr = rd_ptr ^ (rd_ptr >> 1);

always @(posedge r_clk or negedge r_rstn)
begin
    if (!r_rstn)
        rd_ptr <= 0;
    else if (!empty && r_inc)
        rd_ptr <= rd_ptr + 1;
end

assign rd_addr = rd_ptr[P_SIZE-2:0];

always @(posedge r_clk or negedge r_rstn)
begin
    if (!r_rstn)
        gray_rd_ptr <= 0;
    else
        gray_rd_ptr <= comb_gray_rd_ptr;
end

assign empty = (sync_wr_ptr == comb_gray_rd_ptr);

endmodule
