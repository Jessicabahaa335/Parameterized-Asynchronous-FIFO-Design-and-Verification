module fifo_wr #(
  parameter P_SIZE = 8
)
(
   input  wire                   w_clk,
   input  wire                   w_rstn,
   input  wire                   w_inc,
   input  wire [P_SIZE-1:0]     sync_rd_ptr,
   output wire [P_SIZE-2:0]     w_addr,
   output reg  [P_SIZE-1:0]     gray_w_ptr,
   output wire                   full
);

reg [P_SIZE-1:0] w_ptr;

wire [P_SIZE-1:0] comb_gray_w_ptr;

assign comb_gray_w_ptr = w_ptr ^ (w_ptr >> 1);

always @(posedge w_clk or negedge w_rstn)
begin
    if (!w_rstn)
        w_ptr <= 0;
    else if (!full && w_inc)
        w_ptr <= w_ptr + 1;
end

assign w_addr = w_ptr[P_SIZE-2:0];

always @(posedge w_clk or negedge w_rstn)
begin
    if (!w_rstn)
        gray_w_ptr <= 0;
    else
        gray_w_ptr <= comb_gray_w_ptr;
end

assign full = (
    sync_rd_ptr[P_SIZE-1] != comb_gray_w_ptr[P_SIZE-1] &&
    sync_rd_ptr[P_SIZE-2] != comb_gray_w_ptr[P_SIZE-2] &&
    sync_rd_ptr[P_SIZE-3:0] == comb_gray_w_ptr[P_SIZE-3:0]
);

endmodule
